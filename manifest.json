{
  "manifest_version": 3,
  "name": "Faculty Eval Pro",
  "version": "3.0.0",
  "description": "Smart auto-fill for faculty evaluation forms with AI-generated feedback.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
